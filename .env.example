# Copy to `.env.local` and fill in. Never commit real values.
# Never put secrets in NEXT_PUBLIC_* variables (they are shipped to the browser).
# Setup guide (local, Neon, Vercel): docs/architecture/database.md

# --- Database (US-003, ADR-0014) ---
# Runtime connection with the `app` role (DML only). On Neon use the POOLED host (-pooler).
# Local (compose.yaml): postgres://app:app_local@127.0.0.1:5432/read_in_blocks
DATABASE_URL=
# Migrations only (`pnpm db:migrate`, Vercel build) with the `migrator` role. On Neon use the DIRECT host.
# Local (compose.yaml): postgres://migrator:migrator_local@127.0.0.1:5432/read_in_blocks
MIGRATOR_DATABASE_URL=

# --- Integration tests (`pnpm test:integration`) ---
# Put these in `.env.test.local` (or the environment). Point them at the local test database only.
# TEST_DATABASE_URL=postgres://app:app_local@127.0.0.1:5432/read_in_blocks_test
# TEST_MIGRATOR_DATABASE_URL=postgres://migrator:migrator_local@127.0.0.1:5432/read_in_blocks_test

# --- Authentication (US-004, ADR-0005, ADR-0016) ---
# Guide: docs/architecture/authentication.md. Use a different secret per environment.
# Generate with: openssl rand -base64 32 (at least 32 characters; required in production).
BETTER_AUTH_SECRET=
# Public URL of this environment. Local: http://localhost:3000. Production: https://read-in-blocks.vercel.app
# Not set on Preview.
BETTER_AUTH_URL=
# Google OAuth client (Google Cloud Console). Local and Production only: Preview gets none and its
# login page says sign-in is unavailable (ADR-0016). Set both or neither.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may sign in (D-10): comma-separated Google e-mails. Empty = nobody can sign in.
AUTH_ALLOWED_EMAILS=
